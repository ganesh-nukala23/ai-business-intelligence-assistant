# Copy this file to ".env" and fill in your key. Never commit the real .env file.

# Optional. Without a key the app still works using the rule-based fallback.
ANTHROPIC_API_KEY=

# Optional. Model used for question interpretation.
ANTHROPIC_MODEL=claude-sonnet-5-5

# Optional. Only change these if you move the files.
# DB_PATH=data/sales.db
# CSV_PATH=data/sales.csv
